# Public address of the site, used for SEO (sitemap, social previews).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Stripe secret key. When set, checkout takes real card payments.
# Find it at https://dashboard.stripe.com/apikeys (starts with sk_live_ or sk_test_).
STRIPE_SECRET_KEY=

# Where contact-form messages and order questions should go.
NEXT_PUBLIC_CONTACT_EMAIL=
